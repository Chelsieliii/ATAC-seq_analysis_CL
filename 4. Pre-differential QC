#To loop through all files
#!/bin/bash
#PBS -lwalltime=24:00:00
#PBS -lselect=1:ncpus=128:mem=900gb
set -e
cd "$PBS_O_WORKDIR"
module load miniforge/3
eval "$(/rds/general/user/xl1720/home/miniforge3/bin/conda shell.bash hook)"
conda activate align_env
BAM_DIR="/rds/general/project/diantonio/live/Chelsie/ATAC_seq_H2O2_D12_Rhi/All_ATAC/trimmed_removepolyG/aligned"
PEAK_DIR="/rds/general/project/diantonio/live/Chelsie/ATAC_seq_H2O2_D12_Rhi/All_ATAC/call_peak"

for BAM in "${BAM_DIR}"/*.dedup.sort.nomito.mapq30.bam
do
SAMPLE=$(basename "$BAM" .bl.dedup.sort.nomito.mapq30.bam)
PEAKS="${PEAK_DIR}/mapq30_${SAMPLE}_peaks.narrowPeak"

echo "Processing ${SAMPLE}..."
echo "BAM: ${BAM}"
echo "PEAKS: ${PEAKS}"
if [ ! -f "$PEAKS" ]; then
    echo "WARNING: Peak file not found for ${SAMPLE}"
    echo "Expected: ${PEAKS}"
    echo "Skipping ${SAMPLE}..."
    continue
fi

#Keep properly paired reads
samtools view -b -f 2 "$BAM" > "${SAMPLE}.properpair.bam"
#Name sort the bam file first so that paired end reads appear next to each other
samtools sort -n -o "${SAMPLE}.properpair.namesort.bam" "${SAMPLE}.properpair.bam"
echo "name sorted"
#Convert paired reads to BEDPE
bedtools bamtobed -bedpe -i "${SAMPLE}.properpair.namesort.bam" > "${SAMPLE}.bedpe"
#Convert BEDPE to fragment BED
awk 'BEGIN{OFS="\t"} $1==$4 {print $1,$2,$6}' "${SAMPLE}.bedpe" > "${SAMPLE}.fragments.bed"
#Count total fragments
TOTAL=$(wc -l < "${SAMPLE}.fragments.bed")
#Fragments that overlap with peaks
bedtools intersect -u -a "${SAMPLE}.fragments.bed" -b "$PEAKS" > "${SAMPLE}.fragments.inpeaks.bed"
#Count fragments in peaks
IN_PEAKS=$(wc -l < "${SAMPLE}.fragments.inpeaks.bed")
#Calculate FRiP
FRIP=$(awk -v a="$IN_PEAKS" -v b="$TOTAL" 'BEGIN {printf "%.4f", a/b}') #Here it does calculation, %.4f tells how many decimal places to output. 

echo "Sample: $SAMPLE"
echo "Total fragments: $TOTAL"
echo "Fragments in peaks: $IN_PEAKS"
echo "FRiP: $FRIP"
#Remove process files
rm "${SAMPLE}.properpair.bam"
rm "${SAMPLE}.properpair.namesort.bam"
rm "${SAMPLE}.bedpe"
rm "${SAMPLE}.fragments.bed"
rm "${SAMPLE}.fragments.inpeaks.bed"
done
