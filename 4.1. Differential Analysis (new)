#The following is conducted in Rstudio.
#Download all libraries needed (See general code)
#Set work directory. Then import libraries.
library(DESeq2)
library(ggplot2)
library(pheatmap)
#import the featurecount file as a variable. Then import the matrix from the count file. 
COUNT_FILE <- "ATAC_merged_peak_counts.txt"
counts <- read.delim( COUNT_FILE, header = TRUE, row.names = 1, check.names = FALSE, comment.char="#" ) #Note that comment.char here tells R that the first row is comment for featurecount job instead of the header)
#Remove annotation columns (chromosome, strand, start, end, direction etc.) generated by featurecount
annotation_cols <- c( "Chr", "Start", "End", "Strand", "Length" )
annotation_cols <- annotation_cols[ annotation_cols %in% colnames(counts) ] #Check if annotation_cols exist in column names
if (length(annotation_cols) > 0) { counts <- counts[, !colnames(counts) %in% annotation_cols] } #Keep all columns that are not in annotation_cols (! means opposite)
#Fix the remaining column names as when they were generated they might contain long directory
names(counts)<-c("A_124_138","A_127","A_128","A_129","A_136","A_137")
sample_info <- data.frame( row.names = colnames(counts), condition = factor( c( "SEN", "CTR", "CTR", "CTR", "SEN", "SEN" ), levels = c("CTR", "SEN") ) ) #Add conditions to each column. 
#Run dds to generate count matrix
dds <- DESeqDataSetFromMatrix( countData = counts, colData = sample_info, design = ~ condition )
#Filter and keep the samples that has read counts >= 10 in at least 2 samples.
keep <- rowSums(counts(dds) >= 10) >= 2
dds <- dds[keep, ] #dds[row,column], here only rows in keep is kept. 
cat(
    "Number of peaks retained:",
    nrow(dds),
    "\n"
) #Check how many peaks are left. 
#Run DESeq2
dds <- DESeq(dds)
#Save results
res <- results( dds, contrast = c( "condition", "SEN", "CTR" ) )
#Rank in padj values
res <- res[ order(res$padj, na.last = TRUE), ]
#Save to current directory
write.csv(as.data.frame(res), file = "DESeq2_SEN_vs_CTR_ATAC_all_nonshrink.csv")

#Since we removed the columns with coordinates earlier for deseq2, not put the columns back.
fc <- read.delim(
    "ATAC_peak_counts.txt",
    header = TRUE,
    row.names = 1,
    check.names = FALSE,
    comment.char = "#"
)
peak_annotation <- fc[, c("Chr", "Start", "End", "Strand", "Length")]
res_df <- as.data.frame(res)
res_df$peak_id <- rownames(res_df) #Get the peak id from res. 
res_df <- cbind(
    peak_annotation[res_df$peak_id, ],
    res_df
)  #cbind function means column bind. We combine columns in peak annotation by peak id in res_df$peak_id. 
#Save the results
write.csv(
    res_df,
    file = "DESeq2_SEN_vs_CTR_withcoordinate.csv",
    row.names = FALSE
)
