#Generate consensus peak file, notice difference between merge or unmerged (used merged in this case)

#Convert bed file to gtf file for featurecount to read the files. Add placeholder columns to bed files. 
awk 'BEGIN{OFS="\t"} {
     print $1, "ATAC", "peak", $2+1, $3, ".", ".", ".", "gene_id \"peak_"NR"\"; transcript_id \"peak_"NR"\";"
 }' combined_ctr_sen_consensus_peaks_merged.bed > combined_ctr_sen_consensus_peaks_merged.gtf
#Note that $2+1 because bed file is 0-based while gtf file is 1-based, thus need to adjust the coordinate. 

