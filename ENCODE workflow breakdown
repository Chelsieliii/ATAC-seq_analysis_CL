#This part instructs python how to read the input from user
def parse_arguments():
    parser = argparse.ArgumentParser(prog='ENCODE TSS enrichment.')  #Give programme a name in case there is error message etc. argparse is a python model that handles command line arguments.
    parser.add_argument('--read-len-log', type=str,
                        help='Read length log file (from aligner task).')  #handles a log file for read length. 
    parser.add_argument('--read-len', type=int,
                        help='Read length (integer). This is ignored if '
                             '--read-len-log is defined.')  #handles input of --read-len as an integer. The user can either input log file or input read length itself. 
    parser.add_argument('--nodup-bam', type=str,
                        help='Raw BAM file (from task filter).')  #path to bam file
    parser.add_argument('--chrsz', type=str,
                        help='2-col chromosome sizes file.') #chromosome size file input
    parser.add_argument('--tss', type=str, help='TSS definition bed file.') #input tss info as a bed file
    parser.add_argument('--out-dir', default='', type=str,
                        help='Output directory.') 
    parser.add_argument('--log-level', default='INFO', help='Log level',
                        choices=['NOTSET', 'DEBUG', 'INFO', 'WARNING',
                                 'CRITICAL', 'ERROR', 'CRITICAL'])  #This defines what to output in the log of this run. Default is "INFO".
    args = parser.parse_args()  #put all input commands into args for following use. E.g. args.tss corresponds to the tss file input

    if args.read_len_log is None and args.read_len is None:
        raise ValueError('Either --read-len-log or --read-len must be defined.') #This requires the read length to be input by user. 

    log.setLevel(args.log_level)
    log.info(sys.argv) #Here it generates the log report for this function. 
    return args

def make_tss_plot(bam_file, tss, prefix, chromsizes,
                  read_len, bins=400, bp_edge=2000,
                  processes=8, greenleaf_norm=True):
    '''
    Take bootstraps, generate tss plots, and get a mean and
    standard deviation on the plot. Produces 2 plots. One is the
    aggregation plot alone, while the other also shows the signal
    at each TSS ordered by strength.
    '''
    logging.info('Generating tss plot...')
    tss_plot_file = '{0}.tss_enrich.png'.format(prefix)
    tss_plot_large_file = '{0}.large_tss_enrich.png'.format(prefix)
    tss_log_file = '{0}.tss_enrich.qc'.format(prefix) #These three lines are setting the file name for output. 
# Load the TSS file
    tss = pybedtools.BedTool(tss) #using pybedtools to load the bed file as python object. 
    tss_ext = tss.slop(b=bp_edge, g=chromsizes)  #slop expands the genomic interval. If bp_edge = 2000, we expand the TSS area we look at to +- 2000bp. so we are looking around TSS region. The g argument inputs a chromosome size file to tell the expansion not to exceed chromosome size. 
# Load the bam file
    # Need to shift reads and just get ends, just load bed file?
    bam = metaseq.genomic_signal(bam_file, 'bam')
# Shift to center the read on the cut site. Here we use bam.array which calculates the signal at TSS in bins. tss_ext is the extended TSS regions which just obtained. bins segment the regions into bins. 
    bam_array = bam.array(tss_ext, bins=bins, shift_width=-read_len/2,
                          processes=processes, stranded=True)  #shift_width = read_len/2 because ATAC-seq reads do not correspond to Tn5 cut site, we need to shift the read to centre it. read_len/2 is kinda universal, as we want to centre the read which is at half of the read length instead of at the ends of the read. 
    #processes defines how many computer power is used. stranded = True means we consider strand information. 
# Normalization (Greenleaf style): Find the avg height at the end bins and take fold change over that
    if greenleaf_norm:
        # Use enough bins to cover 100 bp on either end
        num_edge_bins = int(100/(2*bp_edge/bins)) #Here we are calculating how many bins are there in 100 bp. exntension size*2 as total exntension, divided by bin number -> bin length. 100/bin length gives how many bins are there in 100 bp. We take 100 bp at both ends to estimate background. 
        bin_means = bam_array.mean(axis=0)  #This calculates average ATAC signal across the TSS region. bam_array essentially is a matrix, and axis=0 instructs it to average across the row. 
        avg_noise = (sum(bin_means[:num_edge_bins]) +
                     sum(bin_means[-num_edge_bins:]))/(2*num_edge_bins)  #This calculates the average background noise across two 100bp at each end of the TSS. 
        bam_array /= avg_noise  #This is essentially bam_array = bam_array / avg_noise, calculating fold change of TSS signal over background. -> TSS enrichment
    else:
        bam_array /= bam.mapped_read_count() / 1e6  #We can also use another type of normalisation which divide bam.array by total mapped reads/1e6, this is a normalisation of all signals against the sequencing depth. Which method to use depends on what question needs to be answered. 
