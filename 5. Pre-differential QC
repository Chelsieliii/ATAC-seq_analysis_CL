#A script to loop through all bam files and generate TSS enrichment
#!/bin/bash
#PBS -lwalltime=24:00:00
#PBS -lselect=1:ncpus=128:mem=900gb
module load miniforge/3
eval "$(/rds/general/user/xl1720/home/miniforge3/bin/conda shell.bash hook)"
conda activate encd-atac-py2
cd $PBS_O_WORKDIR
set -e
for file in /rds/general/project/diantonio/live/Chelsie/ATAC_seq_H2O2_D12_Rhi/All_ATAC/trimmed_removepolyG/aligned/*.bl.dedup.sort.nomito.mapq30.bam
do
name=`basename $file .bam`
echo $name
python2 $(which encode_task_tss_enrich.py) --read-len 150 --nodup-bam $file --chrsz /rds/general/project/diantonio/live/Chelsie/ref_genome/encode_hg38/GRCh38_EBV.chrom.sizes.tsv --tss /rds/general/project/diantonio/live/Chelsie/ref_genome/encode_hg38/ENCFF356LFX.bed.gz
echo "TSS enrichment generated for $name"
done
