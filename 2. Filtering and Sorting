#Additional step to remove mitochondrial reads and index the file
#!/bin/bash
#PBS -lwalltime=30:00:00
#PBS -lselect=1:ncpus=128:mem=900gb
set -e
cd "$PBS_O_WORKDIR"
module load miniforge/3
eval "$(/rds/general/user/xl1720/home/miniforge3/bin/conda shell.bash hook)"
conda activate align_env
mkdir -p $PBS_O_WORKDIR/tmp
for file in $PBS_O_WORKDIR/*.bl.dedup.sort.bam
do
name=`basename $file .bam`
echo $name
samtools view -h $file | grep -v chrM | samtools view -h -b - > $name.nomito.bam
echo "remove mito reads"
samtools index "$name.nomito.bam"
echo "Indexed $name.nomito.bam"
done

#Mapq filtering to remove low confidence, multi-mapped, poor alignment reads (if needed) This code set the threshold to 30. can be changed if needed. 
samtools view -b -q 30 sample.nomito.bam > sample.nomito.mapq30.bam 
