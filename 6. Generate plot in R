#After differential analysis
#Volcano plot
volcano_data <- as.data.frame(res)
volcano_data$significant <- "Not significant"  #Add a new column significant, and assign all as not significant
volcano_data$significant[ !is.na(volcano_data$padj) & volcano_data$padj < 0.05 & volcano_data$log2FoldChange >= 1 ] <- "Increased"
volcano_data$significant[ !is.na(volcano_data$padj) & volcano_data$padj < 0.05 & volcano_data$log2FoldChange <= -1 ] <- "Decreased"
p <- ggplot( volcano_data, aes( x = log2FoldChange, y = -log10(padj), colour = significant ) ) + geom_point(alpha = 0.6) + theme_classic() + labs( title = "ATAC-seq differential accessibility", x = "log2 fold change", y = "-log10 adjusted p-value" ) + geom_vline( xintercept = c(-1, 1), linetype = "dashed" ) + geom_hline( yintercept = -log10(0.05), linetype = "dashed" )
ggsave("Volcano_plot.png", p, width = 7, height = 6, dpi = 300 )

